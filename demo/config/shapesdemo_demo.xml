<?xml version="1.0"?>
<!--
Demonstration-specific Routing Service configuration for the RTI Kafka
adapter + Protobuf transformation example.

This file is derived from the upstream
examples/kafka/kafka-shapes-protobuf/shapesdemo_kafka_protobuf.xml but fixes
the message-feedback risk called out in the top-level README: the upstream
file routes DDS topic "Square" to Kafka topic "Square" and then routes that
same Kafka topic back to DDS. Here the two directions use different shape
topics so both routes can run concurrently:

  DDS Square   -> Kafka Square   (serialize)
  Kafka Circle -> DDS Circle     (deserialize)

$(KAFKA_BOOTSTRAP_SERVERS) and $(DDS_DOMAIN_ID) are Routing Service variables.
Start-Demo.ps1 sets them as environment variables (or pass -DKAFKA_BOOTSTRAP_SERVERS=...
and -DDDS_DOMAIN_ID=... on the rtiroutingservice command line) so the broker
address and DDS domain can be overridden without editing this file.
-->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/latest/rti_routing_service.xsd">
    <plugin_library name="plugin_library">
        <adapter_plugin name="kafka_adapter">
            <dll>
                rtikafkaadapter
            </dll>
            <create_function>
                RTI_RS_Kafka_AdapterPlugin_create
            </create_function>
        </adapter_plugin>
        <transformation_plugin name="protobuf_transformation">
            <dll>
                rtiprotobuftransf
            </dll>
            <create_function>
                RTI_TSFM_ProtobufTransformationPlugin_create
            </create_function>
        </transformation_plugin>
    </plugin_library>
    <types>
        <struct name="ShapeType" extensibility="extensible">
            <member name="color" stringMaxLength="128" type="string" key="true"/>
            <member name="x" type="long"/>
            <member name="y" type="long"/>
            <member name="shapesize" type="long"/>
        </struct>
        <module name="RTI">
            <module name="Kafka">
                <struct name="MessagePayload" nested="true">
                    <member name="data" sequenceMaxLength="-1" type="byte" />
                </struct>
                <struct name="Message">
                    <member name="payload" type="nonBasic" nonBasicTypeName="RTI::Kafka::MessagePayload" />
                </struct>
            </module>
        </module>
    </types>
    <routing_service name="shapesdemo_bridge">
        <annotation>
            <documentation>
                Demonstration bridge between RTI Shapes Demo and Kafka using
                separate Square (DDS-to-Kafka) and Circle (Kafka-to-DDS)
                topics to avoid a feedback loop.
            </documentation>
        </annotation>
        <domain_route name="domain_route">
            <participant name="dds">
                <domain_id>
                    $(DDS_DOMAIN_ID)
                </domain_id>
                <registered_type name="ShapeType" type_name="ShapeType" />
                <registered_type name="RTI::Kafka::Message" type_name="RTI::Kafka::Message" />
            </participant>
            <connection name="kafka" plugin_name="plugin_library::kafka_adapter">
                <property>
                    <value>
                        <element>
                            <name>bootstrap.servers</name>
                            <value>$(KAFKA_BOOTSTRAP_SERVERS)</value>
                        </element>
                    </value>
                </property>
                <registered_type name="ShapeType" type_name="ShapeType" />
                <registered_type name="RTI::Kafka::Message" type_name="RTI::Kafka::Message" />
            </connection>
            <session name="session">
                <!-- DDS Square -> Kafka Square -->
                <route name="dds_to_kafka">
                    <dds_input name="Square" participant="dds">
                        <registered_type_name>ShapeType</registered_type_name>
                    </dds_input>
                    <output connection="kafka">
                        <registered_type_name>RTI::Kafka::Message</registered_type_name>
                        <property>
                            <value>
                                <element>
                                    <name>topic</name>
                                    <value>Square</value>
                                </element>
                                <element>
                                    <name>queue.buffering.max.messages</name>
                                    <value>1000</value>
                                </element>
                            </value>
                        </property>
                        <transformation plugin_name="plugin_library::protobuf_transformation">
                            <input_type_name>ShapeType</input_type_name>
                            <property>
                                <value>
                                    <element>
                                        <name>transform_type</name>
                                        <value>serialize</value>
                                    </element>
                                    <element>
                                        <name>buffer_member</name>
                                        <value>payload.data</value>
                                    </element>
                                    <element>
                                        <name>descriptor_file</name>
                                        <value>shape_type.pbdesc</value>
                                    </element>
                                </value>
                            </property>
                        </transformation>
                    </output>
                </route>
                <!-- Kafka Circle -> DDS Circle -->
                <route name="kafka_to_dds">
                    <input connection="kafka">
                        <registered_type_name>RTI::Kafka::Message</registered_type_name>
                        <property>
                            <value>
                                <element>
                                    <name>topic</name>
                                    <value>Circle</value>
                                </element>
                                <element>
                                    <name>group.id</name>
                                    <value>shapesdemo-kafka-to-dds-demo</value>
                                </element>
                                <element>
                                    <name>auto.offset.reset</name>
                                    <value>latest</value>
                                </element>
                            </value>
                        </property>
                    </input>
                    <dds_output name="Circle" participant="dds">
                        <registered_type_name>ShapeType</registered_type_name>
                        <transformation plugin_name="plugin_library::protobuf_transformation">
                            <input_type_name>RTI::Kafka::Message</input_type_name>
                            <property>
                                <value>
                                    <element>
                                        <name>transform_type</name>
                                        <value>deserialize</value>
                                    </element>
                                    <element>
                                        <name>buffer_member</name>
                                        <value>payload.data</value>
                                    </element>
                                    <element>
                                        <name>descriptor_file</name>
                                        <value>shape_type.pbdesc</value>
                                    </element>
                                </value>
                            </property>
                        </transformation>
                    </dds_output>
                </route>
            </session>
        </domain_route>
    </routing_service>
</dds>
